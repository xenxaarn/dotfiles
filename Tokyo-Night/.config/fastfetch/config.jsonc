{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/ella/fastfetch-logo.txt",
    "color": { "1": "red", "4": "red", "5": "white" }
  },
  "display": {
    "separator": ": ",
    "color": { "title": "red", "keys": "red", "separator": "white" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "kernel",   "key": "Kernel" },
    { "type": "os",       "key": "Distro" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell",    "key": "Shell" },
    { "type": "memory",   "key": "RAM" }
  ]
}
